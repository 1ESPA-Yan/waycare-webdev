# Copie para .env.local e preencha. O .env.local não vai para o Git (*.local no .gitignore).
# Defina as MESMAS variáveis na Vercel (Project Settings > Environment Variables).

# Supabase da dock v7: Project URL e chave anon (ou publishable).
# Sem elas, o site funciona só no modo demonstração.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sua-chave-anon
